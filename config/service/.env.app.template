# 模版：专供 app 服务使用（请复制为 .env.app 并填写敏感值）

# App
APP_HOST_PORT=8888

# App DB connection
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=<app_db_user>
DB_PASSWORD=<app_db_password>
DB_NAME=gochat

# Binlog reader
BINLOG_ADDR=mysql:3306
BINLOG_USER=<binlog_user>
BINLOG_PASSWORD=<binlog_password>
BINLOG_TABLEDB=gochat

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=<redis_user>
REDIS_PASSWORD=<redis_password>
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=broker:19092
KAFKA_CLIENT_ID=gochat
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_MESSAGE_TIMEOUT_MS=30000
KAFKA_ALLOW_AUTO_CREATE_TOPICS=true
KAFKA_MAX_IN_FLIGHT=5
KAFKA_BACKOFF_MS=100
KAFKA_GROUP_ID=gochat-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_AUTO_COMMIT_INTERVAL_MS=5000
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Cookies & JWT (请替换为安全值)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_PATH=/
CORS_ORIGINS=

JWT_SECRET=<jwt_secret>

# Telemetry 配置
TELEMETRY_ENVIRONMENT=
TELEMETRY_SERVICE_VERSION=1.0.0
TELEMETRY_OTLP_HOST=
TELEMETRY_OTLP_PORT=
TELEMETRY_SAMPLE_RATIO= #0-1
TELEMETRY_METRICS_ENABLED=true
TELEMETRY_TRACE_ENABLED=true
TELEMETRY_ENABLED=true

# Email (可选：如需发送邮件请配置)
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=25
EMAIL_USERNAME=<email_user>
EMAIL_PASSWORD=<email_password>

