# Token
JWT_SECRET=your_jwt_secret_here

# MySQL
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_NAME=gochat

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_PATH=/

# TLS Certs
HTTPS_CERT_FILE=./certs/localhost+2.pem
HTTPS_KEY_FILE=./certs/localhost+2-key.pem

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=25
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password

# Outbox / BinlogReader
BINLOG_ADDR=127.0.0.1:13306
BINLOG_USER=root
BINLOG_PASSWORD=your_db_password_here
BINLOG_TABLEDB=gochat
# 留空表示不使用 mysqldump
BINLOG_EXECUTION_PATH=

# Kafka - Common
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLIENT_ID=gochat-client
# 可选：PLAINTEXT|SSL|SASL_PLAINTEXT|SASL_SSL（大小写均可）
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# 使用 SASL 时必填：PLAIN|SCRAM-SHA-256|SCRAM-SHA-512
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka - Producer
# 必填：all|-1|0|1
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_MESSAGE_TIMEOUT_MS=30000
KAFKA_ALLOW_AUTO_CREATE_TOPICS=true
# 幂等性为 true 时建议 <= 5
KAFKA_MAX_IN_FLIGHT=5
KAFKA_MAX_RETRIES=3
KAFKA_BACKOFF_MS=100

# Kafka - Consumer
KAFKA_GROUP_ID=gochat-group
# 必填：earliest|latest
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_AUTO_COMMIT_INTERVAL_MS=5000
KAFKA_SESSION_TIMEOUT_MS=10000
KAFKA_MAX_POLL_INTERVAL_MS=300000
