{
  "id": null,
  "uid": "gochat-app",
  "title": "GoChat Application",
  "tags": [
    "gochat"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
        "query": "label_values(gochat_process_runtime_go_goroutines, service)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "gochat",
          "value": "gochat"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Active WS Connections",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(gochat_ws_active_connections{service=~\"$service\"})",
          "legendFormat": "active"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"], "values": false } }
    },
    {
      "type": "stat",
      "title": "WS Handshake Success Rate (%)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(gochat_ws_handshake_total{service=~\"$service\",result=\"ok\"}[5m])) / clamp_min(sum(rate(gochat_ws_handshake_total{service=~\"$service\"}[5m])), 1)",
          "legendFormat": "success_rate"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"], "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Kafka Queue Full (5m)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(gochat_kafka_queue_full_total{service=~\"$service\"}[5m])) or vector(0)",
          "legendFormat": "queue_full"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"], "values": false } }
    },
    {
      "type": "stat",
      "title": "Kafka Commit Failed (5m)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(gochat_kafka_commit_failed_total{service=~\"$service\"}[5m])) or vector(0)",
          "legendFormat": "commit_failed"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"], "values": false } }
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "gochat_process_runtime_go_goroutines{service=~\"$service\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Pause p99 (ms)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(gochat_process_runtime_go_gc_pause_ns_bucket{service=~\"$service\"}[5m])) / 1e6",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime (h)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 5 },
      "targets": [
        {
          "expr": "gochat_runtime_uptime_milliseconds_total{service=~\"$service\"} / 1000 / 3600",
          "legendFormat": "uptime"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"], "values": false } }
    },
    {
      "type": "timeseries",
      "title": "DB Connections",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "targets": [
        { "expr": "gochat_go_sql_connections_open{service=~\"$service\"}", "legendFormat": "open {{instance}}" },
        { "expr": "gochat_go_sql_connections_in_use{service=~\"$service\"}", "legendFormat": "in_use {{instance}}" },
        { "expr": "gochat_go_sql_connections_idle{service=~\"$service\"}", "legendFormat": "idle {{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Pause Total (ms)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "targets": [
        {
          "expr": "gochat_process_runtime_go_gc_pause_ns_total{service=~\"$service\"} / 1e6",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WS Disconnects by Reason (rps)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(gochat_ws_disconnect_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WS Read/Write Errors (rps)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "sum(rate(gochat_ws_read_error_total{service=~\"$service\"}[5m]))",
          "legendFormat": "read_error"
        },
        {
          "expr": "sum(rate(gochat_ws_write_error_total{service=~\"$service\"}[5m]))",
          "legendFormat": "write_error"
        },
        {
          "expr": "sum(rate(gochat_ws_send_failure_total{service=~\"$service\"}[5m]))",
          "legendFormat": "send_failure"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WS Message Throughput (tps)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "sum(rate(gochat_ws_message_in_total{service=~\"$service\"}[5m]))",
          "legendFormat": "in"
        },
        {
          "expr": "sum(rate(gochat_ws_message_out_total{service=~\"$service\",result=\"ok\"}[5m]))",
          "legendFormat": "out_ok"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WS Route Latency p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gochat_ws_route_duration_seconds_bucket{service=~\"$service\"}[5m]))) * 1000 or vector(0)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Consume Success Rate (%)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "100 * sum(rate(gochat_kafka_consume_total{service=~\"$service\",result=\"ok\"}[5m])) / clamp_min(sum(rate(gochat_kafka_consume_total{service=~\"$service\"}[5m])), 1)",
          "legendFormat": "success_rate"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Handle p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gochat_kafka_handle_duration_seconds_bucket{service=~\"$service\"}[5m]))) * 1000 or vector(0)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Binlog Reader Failures (5m increase)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 39 },
      "targets": [
        {
          "expr": "sum by (error_type) (increase(gochat_binlog_reader_run_total{service=~\"$service\",result=\"failed\"}[5m]))",
          "legendFormat": "{{error_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox Failures (5m increase)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 46 },
      "targets": [
        {
          "expr": "sum by (stage, error_type) (increase(gochat_outbox_process_total{service=~\"$service\",result=\"failed\"}[5m]))",
          "legendFormat": "{{stage}}/{{error_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox Process p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "Prometheus", "name": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 46 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(gochat_outbox_process_duration_seconds_bucket{service=~\"$service\"}[5m]))) * 1000",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ],
  "overwrite": true
}